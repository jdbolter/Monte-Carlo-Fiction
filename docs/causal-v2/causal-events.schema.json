{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monte-carlo-fiction.local/schemas/causal-events-v2.json",
  "title": "Monte Carlo Fiction causal events v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "themeId", "events"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "themeId": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "time",
        "activation",
        "commonEffects",
        "outcomes",
        "sourceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": ["string", "null"] },
        "lineage": { "type": ["string", "null"] },
        "time": { "$ref": "#/$defs/timeWindow" },
        "activation": {
          "type": "string",
          "enum": ["default", "explicit"],
          "description": "Default events enter the eligible pool when their time and requirements permit. Explicit events must first be named by an enables effect."
        },
        "baseWeight": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "requires": { "$ref": "#/$defs/conditionGroup" },
        "commonEffects": { "$ref": "#/$defs/effects" },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "canonical",
        "weight",
        "description",
        "requirement",
        "confidence",
        "evidenceType",
        "rationale",
        "effects",
        "narrativeConsequences"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "canonical": { "type": "boolean" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "description": { "type": "string", "minLength": 1 },
        "requirement": { "type": ["string", "null"] },
        "requires": { "$ref": "#/$defs/conditionGroup" },
        "confidence": {
          "type": "string",
          "enum": ["low", "low-medium", "medium", "medium-high", "high"]
        },
        "evidenceType": {
          "type": "string",
          "enum": ["documented", "historical-inference", "speculative"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "effects": { "$ref": "#/$defs/effects" },
        "narrativeConsequences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "earliest", "latest", "resolution"],
      "properties": {
        "display": { "type": "string", "minLength": 1 },
        "earliest": { "type": "string", "format": "date" },
        "latest": { "type": "string", "format": "date" },
        "resolution": {
          "type": "string",
          "enum": ["day", "month", "year", "range", "circa"]
        }
      }
    },
    "conditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "any": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "none": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fact", "operator", "value"],
          "properties": {
            "kind": { "const": "fact" },
            "fact": { "$ref": "#/$defs/id" },
            "operator": {
              "type": "string",
              "enum": ["equals", "notEquals", "in", "greaterThanOrEqual", "lessThanOrEqual"]
            },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "eventId"],
          "properties": {
            "kind": { "const": "eventOccurred" },
            "eventId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "eventId", "outcomeId"],
          "properties": {
            "kind": { "const": "outcomeChosen" },
            "eventId": { "$ref": "#/$defs/id" },
            "outcomeId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sets": {
          "type": "object",
          "additionalProperties": {}
        },
        "trajectoryDelta": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": -5, "maximum": 5 }
        },
        "enables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "disables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "influences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eventId", "weightMultiplier", "rationale"],
            "properties": {
              "eventId": { "$ref": "#/$defs/id" },
              "weightMultiplier": { "type": "number", "exclusiveMinimum": 0 },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    }
  }
}
