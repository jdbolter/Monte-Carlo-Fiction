{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monte-carlo-fiction.local/schemas/causal-theme-config-v2.json",
  "title": "Monte Carlo Fiction causal theme config v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "eventFile",
    "stateRegistryFile",
    "startEventId",
    "startDate",
    "endDate",
    "stepsPerWorld",
    "axes",
    "worldgen",
    "render"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "eventFile": { "type": "string", "minLength": 1 },
    "stateRegistryFile": { "type": "string", "minLength": 1 },
    "startEventId": { "$ref": "#/$defs/id" },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "stepsPerWorld": { "type": "integer", "minimum": 1 },
    "axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "worldgen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "topN", "divergencePolicy"],
      "properties": {
        "selector": { "const": "causal" },
        "topN": { "type": "integer", "minimum": 1 },
        "timeDecayWeight": { "type": "number", "minimum": 0 },
        "rankWeightExponent": { "type": "number", "exclusiveMinimum": 0 },
        "divergencePolicy": { "$ref": "#/$defs/divergencePolicy" }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "maxTokens", "minWords", "maxWords"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "minWords": { "type": "integer", "minimum": 1 },
        "maxWords": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "divergencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["baseline", "single", "limited", "naturalistic", "all-counterfactual"]
        },
        "minDivergences": { "type": "integer", "minimum": 0 },
        "maxDivergences": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "limited" } },
            "required": ["mode"]
          },
          "then": {
            "required": ["minDivergences", "maxDivergences"]
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    }
  }
}
