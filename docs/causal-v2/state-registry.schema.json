{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monte-carlo-fiction.local/schemas/state-registry-v2.json",
  "title": "Monte Carlo Fiction state registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "themeId", "axes", "facts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "themeId": { "$ref": "#/$defs/id" },
    "axes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/axis" }
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/fact" }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["negativePole", "positivePole", "eventDeltaRange"],
      "properties": {
        "negativePole": { "type": "string", "minLength": 1 },
        "positivePole": { "type": "string", "minLength": 1 },
        "eventDeltaRange": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "default", "description"],
          "properties": {
            "type": { "const": "boolean" },
            "default": { "type": "boolean" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values", "default", "description"],
          "properties": {
            "type": { "const": "enum" },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "default": { "type": "string" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum", "maximum", "default", "description"],
          "properties": {
            "type": { "const": "number" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "default": { "type": "number" },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    }
  }
}
